<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Runtime assembly shipped inside the Egil.StronglyTypedPrimitives NuGet package (see the
      generator project's pack items). Each target framework is intentional:
        net11.0       Preferred active target; provides the OpenAPI schema transformer built
                      against the Microsoft.OpenApi v3 API (StronglyTypedSchemaTransformer.net10OrGreater.cs).
                      Microsoft documents Microsoft.OpenApi v2 -> v3 as binary incompatible for
                      libraries compiled against v2, so net10.0 cannot serve .NET 11 consumers.
        net10.0       Support-window target; provides the OpenAPI schema transformer built against
                      the Microsoft.OpenApi v2 API (StronglyTypedSchemaTransformer.net10OrGreater.cs).
        net9.0        Support-window target; provides the OpenAPI schema transformer built against
                      the Microsoft.OpenApi v1 API (StronglyTypedSchemaTransformer.net9.cs).
        net8.0        LTS support-window target for consumers on .NET 8 (attribute + interfaces only).
        netstandard2.0 Broad consumer compatibility (for example .NET Framework / older runtimes).
    -->
    <TargetFrameworks>net11.0;net10.0;net9.0;net8.0;netstandard2.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!--
      The trim/AOT analyzers keep StronglyTypedJsonConverter free of reflection so consumers with
      IsAotCompatible get no IL2026/IL3050 from the generated [JsonConverter] attribute. The
      property is only understood by net7.0+ SDK targets, hence the condition.
    -->
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <RootNamespace>Egil.StronglyTypedPrimitives</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateSBOM>false</GenerateSBOM>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNet.ReproducibleBuilds">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0' or '$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' or '$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.OpenApi" />
  </ItemGroup>

</Project>

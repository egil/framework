{
  "stryker-config": {
    "project": "src/Egil.SystemTextJson.Migration/Egil.SystemTextJson.Migration.csproj",
    "test-projects": [
      "test/Egil.SystemTextJson.Migration.Tests/Egil.SystemTextJson.Migration.Tests.csproj"
    ],
    "reporters": [
      "json",
      "progress",
      "cleartext"
    ],
    "mutate": [
      "**/JsonMigrationBuilder.cs",
      "**/Migrations/JsonMigratableConverter.cs",
      "**/Migrations/JsonMigratableConverter.NonObjectMatching.cs",
      "**/Migrations/JsonMigrationTypeInfoResolver.cs",
      "**/Migrations/MigrationScope.cs",
      "**/Migrations/PlainContractResolver.cs",
      "**/Migrations/ResolverProbe.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "additional-timeout": 10000
  }
}
